{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lishogi",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://shogi.what-the-fuck.men",
    "BACKUP_INTERVAL_SECONDS": "60",
    "MAIL_FROM": "shogi@what-the-fuck.men"
  },
  "secrets": {
    "required": [
      "CONTAINER_CONTROL_TOKEN",
      "PLAY_SECRET",
      "USER_PASSWORD_SECRET",
      "SHOGINET_KEY"
    ]
  },
  "routes": [
    {
      "pattern": "shogi.what-the-fuck.men",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "LishogiServer",
      "image": "./cloudflare/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-4",
      "max_instances": 1,
      "constraints": {
        "regions": ["APAC"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LISHOGI",
        "class_name": "LishogiServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LishogiServer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "lishogi-backups"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
